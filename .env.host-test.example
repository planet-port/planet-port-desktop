# e2e-host-test.sh 配置模板
# 复制为 .env.host-test(已被 .gitignore 忽略,不会入库)后按实际填写。
#
# TEST_HOSTS 每行一台,字段用 | 分隔(全部必填):
#   <user>@<ip>|<arch>|<sudo密码>|<fresh>|<互ping目标>
#
# 登录方式: 一律本机 ssh 密钥免密登录,不支持密码登录
#
# 各字段取值:
#   arch  选项清单:
#     amd64  — x86_64 主机(release 资产 linux_amd64)
#     arm64  — aarch64 主机(release 资产 linux_arm64)
#   sudo密码:
#     必填;root 直登时 sudo 不会提示,照填即可
#   fresh  选项清单:
#     0  — 覆盖升级(机器上已有 planet-port,校验同地址恢复)
#     1  — 净装(机器上无 planet-port,会按 PLANET_FILE 补一发 add 导入)
#   互ping目标  选项清单:
#     <IP>  — 数据面验证目标(如另一台已入网的节点)
#     -     — 跳过数据面互 ping

# 当前已实测的主机清单(密码占位,复制为 .env.host-test 后填真实值):
#   RK3566    Ubuntu 20.04 (glibc 2.31)   覆盖升级实测通过(2026-11-07)
#   gozi-mba  Linux Mint 21.3 (glibc 2.35) 覆盖升级实测通过(2026-11-07)
#   openclaw  Ubuntu 24.04 (glibc 2.39)   覆盖升级实测通过(2026-11-06)
#   casaos    Armbian/Debian 13 (glibc 2.41) 净装实测通过(2026-11-07)
# Windows 实测机(huaweimatebook)不适用本脚本,见 docs/install.md 手工步骤。
TEST_HOSTS=(
  "ztl@10.121.15.88|arm64|<sudo密码>|0|10.121.16.71"
  "gozimba@10.152.124.24|amd64|<sudo密码>|0|10.121.16.71"
  "ubuntu@192.168.8.220|amd64|<sudo密码>|0|10.121.16.223"
  "root@192.168.8.211|arm64|<sudo密码任意>|0|10.121.16.71"
)

# 净装机器(fresh=1)补测 planet 导入用的 planet 文件(本机路径),可留空
# PLANET_FILE="$HOME/Library/Application Support/planet-portd/planets/3530253632.bin"

# 测试网络 ID(16 位,净装机 add 后补一发 join;控制器侧需人工授权)
# 选项清单:
#   <16位网络ID>  — 净装机 join 该网络
#   留空          — 跳过 join
NETWORK_ID=5cf54f181554090f

# release 仓库与版本(缺省 latest 正式版)
# GH_REPO=planet-port/planet-port-desktop
# VERSION=v0.3.0
