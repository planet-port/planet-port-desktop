/target
.DS_Store
# ZeroTier 核心源码(bootstrap 产物,不入库)
/Core/
# POC 本地环境:planet 副本与运行期 dataStore
crates/pocs/fixtures/

# Win10 实测机连接配置(含密码,勿提交)
.env.win10

# winserver 实测机连接配置(含密码,勿提交)
.env.winserver

# 主机 e2e 测试配置(含 sudo 密码,勿提交)
.env.host-test

# 本地 scratch(打包演练产物等,一律进 tmp/)
/tmp/

# tcp-proxy 编译产物(scripts/build-tcp-proxy.sh)
/dist-tcp-proxy/

# 构建产物与本地会话文件
/dist/
/claude-session*
docs/superpowers/

# GUI 前端(Tauri)依赖与构建产物
node_modules/
crates/gui/dist/
# tauri-build 每次构建自动重生成的权限清单与 schema
crates/gui/src-tauri/gen/schemas/
# GUI 内嵌资源(scripts/build-gui-portable.sh 组包产物,不入库)
# 用 /* 而非整目录忽略:tauri-build 对 resources 声明的目录"存在即可",不存在则硬失败;
# 反排除 .gitkeep 保证干净 checkout 与 tauri dev 也能过构建
crates/gui/src-tauri/resources/*
!crates/gui/src-tauri/resources/.gitkeep

.env.gozi84
