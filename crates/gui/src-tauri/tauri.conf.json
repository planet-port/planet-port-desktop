{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.5.9",
  "productName": "Planet Port",
  "identifier": "com.planetport.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "label": "main",
        "width": 960,
        "height": 620,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 20, "y": 28 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/background/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage"],
    "resources": ["resources/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
